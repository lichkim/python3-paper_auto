# 논문 검색 API (선택: 키가 없어도 arXiv/Crossref는 동작)
SEMANTIC_SCHOLAR_API_KEY=
PAPER_TREND_SEMANTIC_PREFETCH_DELAY=15
PAPER_TREND_SEMANTIC_PREFETCH_RETRY_DELAY=120
PAPER_TREND_SEMANTIC_PREFETCH_ATTEMPTS=3

# 한국어 LaTeX 전문 번역 (선택: 비어 있으면 번역만 생략)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
PAPER_TREND_TRANSLATION_MODEL=deepseek-v4-flash
PAPER_TREND_SUMMARY_MODEL=deepseek-chat
PAPER_TREND_SUMMARY_MAX_PER_RUN=20

# Telegram (두 값이 모두 있어야 전송)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=PaperTrendBot
TELEGRAM_CHAT_ID=
# TELEGRAM_MESSAGE_THREAD_ID=

# 이메일 테스트 및 향후 사용자별 리포트 발송 (Gmail은 앱 비밀번호 사용)
PAPER_TREND_SMTP_HOST=smtp.gmail.com
PAPER_TREND_SMTP_PORT=465
PAPER_TREND_SMTP_USER=your-address@gmail.com
PAPER_TREND_SMTP_PASSWORD=
PAPER_TREND_EMAIL_TO=your-address@gmail.com

# 실행 범위와 비용 제어
PAPER_TREND_SCAN_DAYS=14
PAPER_TREND_MAX_RESULTS_PER_SOURCE=20
PAPER_TREND_REPORT_TOP_N=10
PAPER_TREND_COMPILE_TEX=true
PAPER_TREND_REQUEST_TIMEOUT=45
# arXiv 운영 정책을 위해 실제 관리 연락처로 바꾸세요.
PAPER_TREND_USER_AGENT=PaperTrend/1.0 (mailto:replace-me@example.com)

# 필요할 때만 런타임 위치 변경
# PAPER_TREND_DATA_DIR=/path/to/data
# PAPER_TREND_CSV_PATH=/path/to/papers.csv
# PAPER_TREND_TOPICS_FILE=/path/to/topics.json
# PAPER_TREND_JOURNALS_FILE=/path/to/journals.json
