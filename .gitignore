# 실제 API 키, 계정 정보, 개인 설정 (.env.example만 공개)
.env
.env.*
!.env.example
*.env
.envrc
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx

# 실행 결과: 빈 폴더 유지용 .gitkeep만 공개
/data/*
!/data/.gitkeep
/downloads/*
!/downloads/.gitkeep
/translations/*
!/translations/.gitkeep
/reports/*
!/reports/.gitkeep
/logs/
/output/
/outputs/
/backups/

# 기본 폴더 밖에 저장하거나 복사한 DB, 논문, 내보내기 파일도 제외
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.sql
*.dump
*.csv
*.tsv
*.jsonl
*.parquet
*.xlsx
*.xls
*.pdf
*.PDF
*.tex
*.bib

# 논문/번역/DB가 포함될 수 있는 압축 파일
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz
*.7z
*.rar

# Python 가상환경, 캐시, 패키지 빌드 결과
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.Python
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
.ipynb_checkpoints/

# 로그, 임시 파일, LaTeX 컴파일 부산물
*.log
*.log.*
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
*.aux
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
.build/

# 개인 개발 도구 설정과 운영체제 메타데이터
.vscode/
.idea/
.codex/
.agents/
.DS_Store
._*
Thumbs.db
Desktop.ini

# 소스, 테스트, JSON 설정, .env.example, Docker 설정은 공개 대상입니다.
# 공개용 PDF/CSV 테스트 자료가 필요하면 해당 경로만 명시적으로 예외 처리하세요.
